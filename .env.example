# Copy to .env and fill in. .env is gitignored and never leaves the server:
# the key is only ever used by server.mjs when it calls the Anthropic API.
#
# On the droplet this file is NOT the template to copy — provision-site seeds
# /var/www/piezo/.env with the right PORT and you add the rest by hand. See
# DEPLOY.md.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=8971
# Loopback only. nginx is the boundary; the app should never bind publicly.
HOST=127.0.0.1
# Model used to write cue programs. Override only if you know why.
SOUNDBOARD_MODEL=claude-opus-5
